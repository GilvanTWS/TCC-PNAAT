# Perfil da bancada TRIA; sem credenciais de rede.
# Aplicado a uma configuração nova; sdkconfig existente tem precedência.
CONFIG_TRIA_CONVEYOR_GPIO=6
CONFIG_TRIA_CONVEYOR_SPEED_PERCENT=65
CONFIG_TRIA_VIBRATION_GPIO=7
CONFIG_TRIA_BUTTON_GPIO=0
CONFIG_TRIA_BUTTON_DEBOUNCE_MS=30
CONFIG_TRIA_SERVO_GPIO=47
# Posições iniciais do código: confirmar com a aleta instalada.
CONFIG_TRIA_ANGULO_A=45
CONFIG_TRIA_ANGULO_B=90
CONFIG_TRIA_ANGULO_C=135
CONFIG_TRIA_TEMPO_SERVO_MS=500
CONFIG_TRIA_OLED_SDA_GPIO=17
CONFIG_TRIA_OLED_SCL_GPIO=18
CONFIG_TRIA_OLED_RESET_GPIO=21
CONFIG_TRIA_OLED_POWER_GPIO=36
CONFIG_TRIA_WATCHDOG_TIMEOUT_S=15
CONFIG_TRIA_STATUS_INTERVAL_S=30
